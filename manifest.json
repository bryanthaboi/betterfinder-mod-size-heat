{
  "manifestVersion": 1,
  "id": "bryanthaboi.size-heat",
  "name": "Size Heat",
  "author": "bryanthaboi",
  "version": "1.1.0",
  "api": ">=1.0.0 <2.0.0",
  "app": ">=1.0.0 <2.0.0",
  "runtime": "ts/1",
  "entry": "scripts/main.ts",
  "license": "MIT",
  "permissions": [
    {
      "kind": "ui.selection",
      "level": "metadata",
      "reason": "Read the size of each visible item, and a folder's measured total, to draw its heat bar"
    },
    {
      "kind": "ui",
      "surfaces": [
        "column"
      ]
    }
  ],
  "contributes": {
    "columns": [
      {
        "id": "heat",
        "title": "Heat",
        "valueType": "string",
        "handler": "heat",
        "sortable": true,
        "width": 90
      }
    ]
  },
  "hooks": [
    {
      "name": "column.values",
      "handler": "heat",
      "version": 1
    }
  ],
  "settings": [],
  "dependencies": [],
  "conflicts": []
}
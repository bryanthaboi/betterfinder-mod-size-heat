{
  "name": "relative-bars",
  "hook": "column.values",
  "input": {
    "column": "heat",
    "revision": 1,
    "items": [
      {"handle": "big", "name": "big.bin", "kind": "file", "size": "1000"},
      {"handle": "small", "name": "small.txt", "kind": "file", "size": "10"},
      {"handle": "empty", "name": "empty", "kind": "file", "size": "0"}
    ]
  },
  "expect": {
    "equals": [
      {"handle": "big", "text": "█████", "sortKey": "00000000000000001000"},
      {"handle": "small", "text": "███░░", "sortKey": "00000000000000000010"},
      {"handle": "empty", "text": "░░░░░", "sortKey": "00000000000000000000"}
    ]
  }
}
